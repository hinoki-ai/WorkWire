{
  "name": "workwire",
  "productName": "WorkWire",
  "version": "0.1.0",
  "description": "Self-contained Linux bundle for the WorkWire two-machine file desk.",
  "desktopName": "workwire.desktop",
  "main": "desktop/ww-runtime.cjs",
  "type": "module",
  "license": "UNLICENSED",
  "author": "hinoki",
  "private": true,
  "bin": {
    "ww": "./ww.mjs",
    "workwire": "./ww.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "bash ./scripts/ww",
    "ww": "bash ./scripts/ww",
    "serve": "bash ./scripts/ww serve",
    "install": "node ./scripts/install-ww.mjs",
    "ww:install": "node ./scripts/install-ww.mjs",
    "autostart": "node ./scripts/install-ww-autostart.mjs",
    "ww:autostart": "node ./scripts/install-ww-autostart.mjs",
    "dist:linux": "node ./scripts/package-ww-linux.mjs",
    "ww:lan-installer": "node ./scripts/serve-ww-lan-installer.mjs"
  },
  "files": [
    "ww.mjs",
    "desktop/**/*",
    "lib/**/*",
    "scripts/**/*",
    "README.md",
    "docs/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2"
  }
}
