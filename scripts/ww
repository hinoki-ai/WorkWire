#!/usr/bin/env bash

set -euo pipefail

INVOCATION_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
STANDALONE_ROOT_CANDIDATE="$(cd -- "$INVOCATION_DIR/.." && pwd -P)"
export WW_HOME_DIR="${WW_HOME_DIR:-$STANDALONE_ROOT_CANDIDATE/.workwire}"
export WW_CONFIG_DIR="${WW_CONFIG_DIR:-$WW_HOME_DIR/config}"
export WW_PORTAL_PATH="${WW_PORTAL_PATH:-$STANDALONE_ROOT_CANDIDATE}"

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

exec "$REPO_DIR/scripts/launch-workwire.sh" "$@"
