#!/bin/sh
set -eu

lb config noauto \
  --mode debian \
  --distribution bookworm \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --binary-images iso-hybrid \
  --chroot-filesystem squashfs \
  --bootappend-live "boot=live components ip=dhcp" \
  --apt-recommends false \
  "${@}"
